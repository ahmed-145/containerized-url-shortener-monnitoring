# AI Report Generator Configuration
# Copy this file to .env and fill in your values

# REQUIRED: Your Cerebras API key
# Get your API key from the Cerebras dashboard
CEREBRAS_API_KEY=your-api-key-here

# Optional: Customize service ports (defaults shown)
# BACKEND_PORT=3000
# FRONTEND_PORT=80
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3001
# RENDERER_PORT=8081
# AI_REPORTER_PORT=4000

# Optional: Grafana authentication (change for production!)
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
